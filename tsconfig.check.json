{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true
  },
  "files": [
    "electron/preload.js",
    "electron/production-hardening.js",
    "electron/main.js",
    "services/security/audit-log.js",
    "services/security/local-password-verifier.js",
    "services/security/redaction.js",
    "services/security/token-store.js",
    "services/security/provider-privacy-policy.js",
    "services/security/intervention-permission-engine.js",
    "services/security/operational-security-policy.js"
  ]
}
