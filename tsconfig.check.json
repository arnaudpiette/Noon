{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true
  },
  "files": [
    "electron/preload.js",
    "electron/production-hardening.js",
    "electron/main.js"
  ]
}
