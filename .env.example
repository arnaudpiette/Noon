# Copiez ce fichier vers .env et renseignez les valeurs uniquement sur votre Mac.
OPENAI_API_KEY=
NOON_HOST=127.0.0.1
NOON_PORT=3000
DRY_RUN_EXTERNAL_WRITES=true
# Mettre à false pour désactiver le chargement différé des skills OpenAI.
ENABLE_TOOL_SEARCH=true
# Compaction stateless des conversations longues (seuil exprimé en tokens).
ENABLE_RESPONSE_COMPACTION=false
RESPONSE_COMPACTION_THRESHOLD_TOKENS=120000
# Analyses explicitement lancées et pollées en arrière-plan.
ENABLE_BACKGROUND_ANALYSIS=false
NOON_MAX_PROACTIVE_NOTIFICATIONS=3

# Google Cloud OAuth — application de bureau ou client Web local.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/integrations/google/callback

# GitHub : privilégier `gh auth login`; sinon token finement limité.
GITHUB_TOKEN=

# Figma OAuth.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://127.0.0.1:3000/integrations/figma/callback
